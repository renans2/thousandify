---
import { IoTriangleSharp } from "react-icons/io5";

interface Props {
  positionOffset: number | null;
}

const { positionOffset } = Astro.props;
// same pill shape as the Daily tags, fixed width so the column stays aligned
const base =
  "w-7.5 md:w-14 h-6 mx-auto rounded-full flex items-center justify-center gap-1 text-xs font-medium";
---

{
  positionOffset === null ? (
    <div class={`${base} bg-tag-bg-yellow text-tag-text-yellow`}>
      <span class="hidden md:inline">NEW</span>
      <span class="md:hidden">N</span>
    </div>
  ) : positionOffset > 0 ? (
    <div class={`${base} bg-tag-bg-red text-tag-text-red`}>
      <IoTriangleSharp
        size={9}
        strokeWidth={0}
        className="hidden md:block rotate-180"
      />
      <span>-{positionOffset}</span>
    </div>
  ) : positionOffset < 0 ? (
    <div class={`${base} bg-tag-bg-green text-tag-text-green`}>
      <IoTriangleSharp size={9} strokeWidth={0} className="hidden md:block" />
      <span>+{Math.abs(positionOffset)}</span>
    </div>
  ) : (
    <div class={`${base} bg-tag-bg-blue`}>
      <div class="w-3 md:w-4 h-0.5 bg-tag-text-blue rounded-full" />
    </div>
  )
}
