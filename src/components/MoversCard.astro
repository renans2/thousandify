---
interface Props {
  title: string;
  description: string;
  // shown instead of the list when it has no rows
  empty?: string | false;
}

const { title, description, empty = false } = Astro.props;
---

<section class="rounded-2xl border border-divider bg-background/60 backdrop-blur-md p-4 md:p-5 shadow-[0_1px_2px_rgb(0_0_0/0.06)]">
  <h3 class="text-sm md:text-base font-bold text-heading">{title}</h3>
  <p class="mt-0.5 mb-3 text-xs md:text-sm text-description">{description}</p>
  {
    empty ? (
      <p class="py-6 text-center text-sm text-description">{empty}</p>
    ) : (
      <ol class="text-xs md:text-sm">
        <slot />
      </ol>
    )
  }
</section>
