---
import { FaGithub } from "react-icons/fa";
import ThemeSwitch from "./ThemeSwitch.astro";
import ReactHeader from "./react/Header";

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
].filter(({ href }) => href !== path);
---

<ReactHeader client:load links={links}>
  <Fragment slot="desktopActions">
    <ThemeSwitch />
    <a
      href="https://github.com/renans2/thousandify"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub repository"
      class="p-1.5 cursor-pointer hover:bg-background-icon-hover rounded-lg transition-colors"
    >
      <FaGithub size={22} className="text-heading" />
    </a>
  </Fragment>
  <Fragment slot="mobileActions">
    <ThemeSwitch />
    <a
      href="https://github.com/renans2/thousandify"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub repository"
      class="p-1.5 cursor-pointer hover:bg-background-icon-hover rounded-lg transition-colors"
    >
      <FaGithub size={22} className="text-heading" />
    </a>
  </Fragment>
</ReactHeader>
