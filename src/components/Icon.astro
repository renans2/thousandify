---
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const { viewBox, body } = ICONS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  class={className}
  set:html={body}
/>
