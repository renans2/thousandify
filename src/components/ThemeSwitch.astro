---
import { HiMoon } from "react-icons/hi2";
import { MdLightMode } from "react-icons/md";
---

<button class="theme-switch group p-2 rounded-full text-description hover:text-heading hover:bg-background-icon-hover cursor-pointer transition-colors" aria-label="Toggle theme">
  <MdLightMode
    size={20}
    className="hidden dark:block text-amber-300 group-hover:rotate-45 transition-transform"
  />
  <HiMoon
    size={20}
    className="dark:hidden text-violet-500 group-hover:-rotate-12 transition-transform"
  />
</button>

<script>
  const root = document.documentElement;
  const systemDark = matchMedia("(prefers-color-scheme: dark)");

  // transitions are turned off while switching, otherwise every row, link and
  // tag animates its colors at once
  function applyTheme(dark: boolean) {
    const noTransitions = document.createElement("style");
    noTransitions.textContent =
      "*,*::before,*::after{transition:none!important}";
    document.head.append(noTransitions);
    root.classList.toggle("dark", dark);
    root.style.colorScheme = dark ? "dark" : "light";
    getComputedStyle(root).colorScheme; // apply the new styles before re-enabling
    requestAnimationFrame(() => noTransitions.remove());
  }

  function savedTheme() {
    try {
      return localStorage.getItem("theme") ?? "system";
    } catch {
      return "system";
    }
  }

  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest(".theme-switch")) return;
    const dark = !root.classList.contains("dark");
    applyTheme(dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });

  systemDark.addEventListener("change", (event) => {
    if (savedTheme() === "system") applyTheme(event.matches);
  });
</script>
