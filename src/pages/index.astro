---
import { IoSearch } from "react-icons/io5";
import { RxCross2 } from "react-icons/rx";
import Trend from "../components/Trend.astro";
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import type { ArtistDailyStat } from "../types/ArtistTypes";

// the daily job doesn't run at midnight UTC, so "today" may have no data yet:
// always show the most recent update instead
const { data: lastUpdate, error: updateError } = await supabase
  .from("update_logs")
  .select("date")
  .order("date", { ascending: false })
  .order("time", { ascending: false })
  .limit(1)
  .maybeSingle();
if (updateError) throw updateError;

let data: ArtistDailyStat[] = [];
if (lastUpdate) {
  const { data: stats, error } = await supabase
    .from("artists_daily_stats")
    .select("*, artist(*)")
    .eq("date", lastUpdate.date)
    .order("position", { ascending: true });
  if (error) throw error;
  data = stats ?? [];
}

const COLUMNS = [
  { key: "position", label: "#", align: "text-center" },
  { key: "trend", label: "Trend", align: "text-center" },
  { key: "artist", label: "Artist", align: "text-left" },
  { key: "listeners", label: "Listeners", align: "text-right" },
  { key: "daily", label: "Daily", align: "text-right" },
];
---

<Layout>
  {
    !lastUpdate ? (
      <p class="text-center text-heading font-medium pb-20">
        No data available yet, check back later.
      </p>
    ) : (
      <div class="max-w-250 mx-auto text-xs md:text-base">
        <div class="px-4 md:px-8 flex gap-2 flex-col md:flex-row md:items-center md:justify-between">
          <p class="self-start md:self-auto inline-flex items-center gap-2 text-sm text-description rounded-full border border-divider bg-background/60 pl-3 pr-3.5 py-1">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full rounded-full bg-accent opacity-60 motion-safe:animate-ping"></span>
              <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
            </span>
            Last update:
            <time datetime={lastUpdate.date} class="text-heading font-medium">
              {lastUpdate.date}
            </time>
          </p>
          <div class="group relative w-full md:w-80 flex items-center">
            <input
              id="artist-search"
              class="peer w-full h-11 pl-11 pr-28 rounded-full border-2 border-divider bg-background/70 backdrop-blur-md text-base text-heading placeholder:text-description shadow-[0_1px_2px_rgb(0_0_0/0.06),inset_0_1px_0_rgb(255_255_255/0.04)] outline-none transition-[box-shadow,border-color] hover:border-border/40 focus:ring-4 focus:ring-accent/15"
              type="search"
              placeholder="Search artists"
              aria-label="Search artists"
              autocomplete="off"
              spellcheck="false"
            />
            <IoSearch
              className="absolute left-4 text-description pointer-events-none transition-colors peer-focus:text-accent"
              size={18}
            />
            <div class="absolute right-2 flex items-center gap-1">
              <span
                id="search-count"
                hidden
                aria-live="polite"
                class="px-2 py-0.5 rounded-full bg-accent/12 text-accent text-xs font-medium tabular-nums whitespace-nowrap"
              ></span>
              <button
                id="search-clear"
                type="button"
                hidden
                aria-label="Clear search"
                class="p-1.5 rounded-full text-description hover:text-heading hover:bg-background-icon-hover cursor-pointer transition-colors"
              >
                <RxCross2 size={16} />
              </button>
              <kbd
                id="search-hint"
                class="hidden md:block group-focus-within:hidden mr-1.5 px-1.5 rounded-md border border-divider bg-background-icon-hover/50 text-xs text-description pointer-events-none"
                title="Press / to search"
              >
                /
              </kbd>
            </div>
          </div>
        </div>
        <div class="overflow-x-auto md:overflow-x-visible pb-20 px-1 md:px-8">
          <table id="ranking" role="table" class="w-full min-w-[23rem] mt-3">
            <thead role="rowgroup" class="md:sticky md:top-0 z-10 bg-background cursor-pointer select-none">
              <tr role="row">
                {COLUMNS.map(({ key, label, align }) => (
                  <th
                    role="columnheader"
                    data-sort={key}
                    class:list={[
                      "py-2.5 px-1 md:px-2 font-bold uppercase md:tracking-wider text-[0.7rem] md:text-xs whitespace-nowrap text-description hover:text-heading hover:bg-heading/5 transition-colors",
                      align,
                    ]}
                  >
                    {label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody role="rowgroup">
              {data.map(
                ({
                  artist,
                  position,
                  monthly_listeners,
                  position_offset,
                  monthly_listeners_daily_offset,
                }) => (
                  <tr
                    role="row"
                    class="border-b border-divider text-table-data hover:bg-linear-to-r hover:from-accent/12 hover:via-accent-2/5 hover:to-transparent"
                    data-position={position}
                    data-trend={position_offset === null ? "" : -position_offset}
                    data-artist={artist.name.toLowerCase()}
                    data-listeners={monthly_listeners}
                    data-daily={monthly_listeners_daily_offset ?? ""}
                  >
                    <td role="cell" class="text-center py-1.5 px-1 md:px-2">
                      {position <= 3 ? (
                        <span class={`medal medal-${position} size-5 md:size-6 text-xs`}>
                          {position}
                        </span>
                      ) : (
                        position
                      )}
                    </td>
                    <td role="cell" class="py-1.5 px-0.5 md:px-1">
                      <Trend positionOffset={position_offset} />
                    </td>
                    <td role="cell" class="py-1.5 px-1 md:px-2">
                      <a
                        href={`https://open.spotify.com/artist/${artist.spotify_id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`${artist.name}'s Spotify profile`}
                        class="underline decoration-heading/20 underline-offset-4 hover:decoration-accent hover:text-heading transition-colors"
                      >
                        {artist.name}
                      </a>
                    </td>
                    <td role="cell" class="text-right py-1.5 px-1 md:px-2 tabular-nums">
                      {monthly_listeners.toLocaleString("en-US")}
                    </td>
                    <td role="cell" class="text-right py-1.5 px-1 md:px-2">
                      {monthly_listeners_daily_offset !== null && (
                        <span
                          class:list={[
                            "inline-block py-0.5 px-1.5 md:px-2 text-xs font-medium tabular-nums rounded-full",
                            monthly_listeners_daily_offset > 0
                              ? "bg-tag-bg-green text-tag-text-green"
                              : monthly_listeners_daily_offset < 0
                                ? "bg-tag-bg-red text-tag-text-red"
                                : "bg-tag-bg-neutral text-tag-text-neutral",
                          ]}
                        >
                          {monthly_listeners_daily_offset > 0 && "+"}
                          {monthly_listeners_daily_offset.toLocaleString(
                            "en-US",
                          )}
                        </span>
                      )}
                    </td>
                  </tr>
                ),
              )}
              <tr id="no-results" role="row" hidden>
                <td role="cell" class="col-span-full text-center py-8 text-description">
                  No artists found
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    )
  }
</Layout>

<script>
  // sort by column and filter by artist name. Sorting only changes each row's
  // CSS order and filtering only hides rows, so one never undoes the other.
  const table = document.getElementById("ranking") as HTMLTableElement | null;

  if (table) {
    const tbody = table.tBodies[0];
    const noResults = document.getElementById("no-results")!;
    const search = document.getElementById("artist-search") as HTMLInputElement;
    const searchCount = document.getElementById("search-count")!;
    const searchClear = document.getElementById("search-clear")!;
    const searchHint = document.getElementById("search-hint")!;
    const headers = [
      ...table.querySelectorAll<HTMLTableCellElement>("th[data-sort]"),
    ];
    const rows = [...tbody.rows].filter((row) => row !== noResults);
    let sort: { key: string; ascending: boolean } | null = null;

    // empty values (e.g. NEW artists have no trend) are null and go last
    function sortValue(row: HTMLTableRowElement, key: string) {
      const raw = row.dataset[key];
      if (!raw) return null;
      return key === "artist" ? raw : Number(raw);
    }

    function compare(a: HTMLTableRowElement, b: HTMLTableRowElement) {
      const x = sortValue(a, sort!.key);
      const y = sortValue(b, sort!.key);
      if (x === y) return Number(a.dataset.position) - Number(b.dataset.position);
      if (x === null) return 1;
      if (y === null) return -1;
      const result =
        typeof x === "string" ? x.localeCompare(y as string) : x - (y as number);
      return sort!.ascending ? result : -result;
    }

    // rows are reordered visually with CSS `order` (tbody is a flex column)
    // instead of being moved in the DOM, which re-laid out all 1000 rows
    function applySort() {
      if (sort) rows.toSorted(compare).forEach((row, i) => (row.style.order = String(i)));
      else for (const row of rows) row.style.order = "";
      for (const header of headers) {
        const active = sort?.key === header.dataset.sort;
        header.dataset.indicator = active ? (sort!.ascending ? "▲" : "▼") : "";
        if (active) header.ariaSort = sort!.ascending ? "ascending" : "descending";
        else header.removeAttribute("aria-sort");
      }
    }

    function applyFilter() {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        row.hidden = !row.dataset.artist!.includes(query);
        if (!row.hidden) visible++;
      }
      noResults.hidden = visible > 0;
      searchCount.hidden = searchClear.hidden = !query;
      searchHint.hidden = Boolean(query);
      searchCount.textContent = `${visible} found`;
    }

    function clearSearch() {
      search.value = "";
      applyFilter();
    }

    for (const header of headers) {
      // each column cycles ascending -> descending -> unsorted (ranking order)
      header.addEventListener("click", () => {
        const key = header.dataset.sort!;
        if (sort?.key !== key) sort = { key, ascending: true };
        else if (sort.ascending) sort = { key, ascending: false };
        else sort = null;
        applySort();
      });
    }
    search.addEventListener("input", applyFilter);
    // the browser may restore the input's text on reload or back navigation
    applyFilter();

    // "/" focuses the search, Escape clears it
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      if (event.key === "/" && !target.closest("input, textarea")) {
        event.preventDefault();
        search.focus();
      }
    });
    search.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      clearSearch();
      search.blur();
    });
    searchClear.addEventListener("click", () => {
      clearSearch();
      search.focus();
    });
  }
</script>

<style>
  /* the table is laid out as a grid of rows (roles above keep it a table for
  screen readers) for two reasons:
  - fixed column widths, so columns don't jump while the rows stream in or
    when the web font loads
  - content-visibility works on grid rows but not on table rows: off-screen
    rows skip rendering, which makes switching the theme much faster */
  #ranking,
  #ranking thead {
    display: block;
  }
  #ranking tbody {
    display: flex;
    flex-direction: column;
  }
  /* always after the rows, whatever the sort */
  #no-results {
    order: 1000000;
  }
  #ranking tr {
    display: grid;
    grid-template-columns: 2.5rem 3.5rem minmax(0, 1fr) 5.5rem 5.25rem;
    align-items: center;
  }
  @media (width >= 48rem) {
    #ranking tr {
      grid-template-columns: 4rem 5rem minmax(0, 1fr) 9rem 7rem;
    }
  }
  #ranking tbody tr {
    content-visibility: auto;
    contain-intrinsic-size: auto 2.3rem;
  }

  /* every sortable header always keeps a fixed slot for the sort indicator, so
  showing it never changes the column width or spills into the next cell */
  th[data-sort]::before,
  th[data-sort]::after {
    display: inline-block;
    width: 1.4em;
    font-size: 0.75em;
    text-align: center;
    vertical-align: 0.1em;
    color: var(--accent);
  }

  /* left-aligned and centered: indicator after the text */
  th[data-sort]::after {
    content: attr(data-indicator);
  }

  /* right-aligned: indicator before the text, so it stays flush with the
  numbers below */
  th.text-right[data-sort]::before {
    content: attr(data-indicator);
  }
  th.text-right[data-sort]::after {
    content: none;
  }

  th[aria-sort] {
    color: var(--accent);
  }

  /* accent gradient line under the table header */
  #ranking thead {
    background-image: linear-gradient(
      90deg,
      var(--accent),
      var(--accent-2),
      var(--accent-3)
    );
    background-size: 100% 2px;
    background-position: bottom;
    background-repeat: no-repeat;
  }

  /* gradient border on the focused search input */
  #artist-search:focus {
    border-color: transparent;
    background:
      linear-gradient(var(--background), var(--background)) padding-box,
      linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent-3))
        border-box;
  }

  /* the "x" button on type="search" inputs; Escape clears instead */
  #artist-search::-webkit-search-cancel-button {
    display: none;
  }
</style>
