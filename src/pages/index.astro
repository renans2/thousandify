---
import { IoSearch } from "react-icons/io5";
import Trend from "../components/Trend.astro";
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import type { ArtistDailyStat } from "../types/ArtistTypes";

// the daily job doesn't run at midnight UTC, so "today" may have no data yet:
// always show the most recent update instead
const { data: lastUpdate, error: updateError } = await supabase
  .from("update_logs")
  .select("date")
  .order("date", { ascending: false })
  .order("time", { ascending: false })
  .limit(1)
  .maybeSingle();
if (updateError) throw updateError;

let data: ArtistDailyStat[] = [];
if (lastUpdate) {
  const { data: stats, error } = await supabase
    .from("artists_daily_stats")
    .select("*, artist(*)")
    .eq("date", lastUpdate.date)
    .order("position", { ascending: true });
  if (error) throw error;
  data = stats ?? [];
}
---

<Layout>
  {
    !lastUpdate ? (
      <p class="text-center text-heading font-medium pb-20">
        No data available yet, check back later.
      </p>
    ) : (
      <div id="data" class="max-w-250 mx-auto text-xs md:text-base">
        <div class="px-2 md:px-8 flex gap-2 md:gap-0 flex-col items-center md:flex-row md:justify-between">
          <p class="font-medium text-base text-heading">
            Last update: {lastUpdate.date}
          </p>
          <div class="text-base w-full md:w-fit relative flex items-center">
            <input
              id="artist-search"
              class="w-full border-2 border-input text-input placeholder-input/50 py-1 pl-10 rounded-lg md:rounded-full focus:outline-3 outline-border"
              type="text"
              placeholder="Filter artist"
              aria-label="Filter artist"
            />
            <IoSearch className="text-input absolute left-2.25" size={24} />
          </div>
        </div>
        <div class="overflow-x-auto pb-20 md:px-8">
          <table id="ranking" class="w-full mt-5">
            <thead class="bg-background z-1 cursor-pointer select-none">
              <tr class="border-b-2 border-border text-table-data">
                <th
                  data-sort="position"
                  class="hover:bg-heading/10 text-center py-2 px-2 font-extrabold"
                >
                  #
                </th>
                <th
                  data-sort="trend"
                  class="hover:bg-heading/10 text-center py-2 px-0 font-extrabold"
                >
                  Trend
                </th>
                <th
                  data-sort="artist"
                  class="hover:bg-heading/10 text-left py-1 pl-2 font-extrabold"
                >
                  Artist
                </th>
                <th
                  data-sort="listeners"
                  class="hover:bg-heading/10 text-right py-1 px-2 font-extrabold"
                >
                  Listeners
                </th>
                <th
                  data-sort="daily"
                  class="hover:bg-heading/10 text-left py-1 px-2 font-extrabold"
                >
                  Daily
                </th>
              </tr>
            </thead>
            <tbody>
              {data.map(
                ({
                  artist,
                  position,
                  monthly_listeners,
                  position_offset,
                  monthly_listeners_daily_offset,
                }) => (
                  <tr
                    class="hover:font-extrabold transition-transform border-b border-border text-table-data"
                    data-position={position}
                    data-trend={position_offset === null ? "" : -position_offset}
                    data-artist={artist.name.toLowerCase()}
                    data-listeners={monthly_listeners}
                    data-daily={monthly_listeners_daily_offset ?? ""}
                  >
                    <td class="text-center py-1">{position}</td>
                    <td class="w-full block mx-auto py-1">
                      <Trend positionOffset={position_offset} />
                    </td>
                    <td class="py-1 pl-2">
                      <a
                        href={`https://open.spotify.com/artist/${artist.spotify_id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`${artist.name}'s Spotify profile`}
                        class="underline md:no-underline hover:underline"
                      >
                        {artist.name}
                      </a>
                    </td>
                    <td class="text-right py-1 px-2">
                      {monthly_listeners.toLocaleString("en-US")}
                    </td>
                    <td class="py-1 px-2">
                      {monthly_listeners_daily_offset !== null && (
                        <span
                          class:list={[
                            "py-1 px-2 text-xs rounded-4xl",
                            monthly_listeners_daily_offset > 0
                              ? "bg-tag-bg-green text-tag-text-green"
                              : monthly_listeners_daily_offset < 0
                                ? "bg-tag-bg-red text-tag-text-red"
                                : "bg-tag-bg-blue text-tag-text-blue",
                          ]}
                        >
                          {monthly_listeners_daily_offset > 0 && "+"}
                          {monthly_listeners_daily_offset.toLocaleString(
                            "en-US",
                          )}
                        </span>
                      )}
                    </td>
                  </tr>
                ),
              )}
              <tr id="no-results" hidden>
                <td colspan="5" class="text-center py-4 text-description">
                  No artists found
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    )
  }

</Layout>

<script>
  // sort by column and filter by artist name. Sorting reorders the rows and
  // filtering only hides them, so one never undoes the other.
  const table = document.getElementById("ranking") as HTMLTableElement | null;

  if (table) {
    const tbody = table.tBodies[0];
    const noResults = document.getElementById("no-results")!;
    const search = document.getElementById("artist-search") as HTMLInputElement;
    const headers = [
      ...table.querySelectorAll<HTMLTableCellElement>("th[data-sort]"),
    ];
    const rows = [...tbody.rows].filter((row) => row !== noResults);
    let sort: { key: string; ascending: boolean } | null = null;

    // empty values (e.g. NEW artists have no trend) are null and go last
    function sortValue(row: HTMLTableRowElement, key: string) {
      const raw = row.dataset[key];
      if (!raw) return null;
      return key === "artist" ? raw : Number(raw);
    }

    function compare(a: HTMLTableRowElement, b: HTMLTableRowElement) {
      const x = sortValue(a, sort!.key);
      const y = sortValue(b, sort!.key);
      if (x === y) return Number(a.dataset.position) - Number(b.dataset.position);
      if (x === null) return 1;
      if (y === null) return -1;
      const result =
        typeof x === "string" ? x.localeCompare(y as string) : x - (y as number);
      return sort!.ascending ? result : -result;
    }

    function applySort() {
      tbody.prepend(...(sort ? rows.toSorted(compare) : rows));
      for (const header of headers) {
        const active = sort?.key === header.dataset.sort;
        header.dataset.indicator = active ? (sort!.ascending ? "▲" : "▼") : "";
        if (active) header.ariaSort = sort!.ascending ? "ascending" : "descending";
        else header.removeAttribute("aria-sort");
      }
    }

    function applyFilter() {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        row.hidden = !row.dataset.artist!.includes(query);
        if (!row.hidden) visible++;
      }
      noResults.hidden = visible > 0;
    }

    for (const header of headers) {
      // each column cycles ascending -> descending -> unsorted (ranking order)
      header.addEventListener("click", () => {
        const key = header.dataset.sort!;
        if (sort?.key !== key) sort = { key, ascending: true };
        else if (sort.ascending) sort = { key, ascending: false };
        else sort = null;
        applySort();
      });
    }
    search.addEventListener("input", applyFilter);
    // the browser may restore the input's text on reload or back navigation
    applyFilter();
  }
</script>

<style>
  /* every sortable header always keeps a fixed slot for the sort indicator, so
  showing it never changes the column width or spills into the next cell */
  th[data-sort]::before,
  th[data-sort]::after {
    display: inline-block;
    width: 1.5em;
    font-size: 0.6em;
    text-align: center;
    vertical-align: middle;
  }

  /* left-aligned: indicator after the text */
  th[data-sort]::after {
    content: attr(data-indicator);
  }

  /* centered: matching empty slot before the text keeps it centered */
  th.text-center[data-sort]::before {
    content: "";
  }

  /* right-aligned: indicator before the text, so it stays flush with the
  numbers below */
  th.text-right[data-sort]::before {
    content: attr(data-indicator);
  }
  th.text-right[data-sort]::after {
    content: none;
  }
</style>
