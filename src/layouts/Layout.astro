---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const title = "Top 1000 Spotify Artists by Monthly Listeners | Thousandify";
const description =
  "Ranking of the 1000 most-listened artists on Spotify by monthly listeners, updated daily, with each artist's position change and daily listener gains and losses.";
// without the query string, so filtered or tracked links count as the same page
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- link previews (Open Graph is also read by Discord, Slack, WhatsApp...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thousandify" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Thousandify: top 1000 Spotify artists by monthly listeners" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <meta name="theme-color" content="#F4F4F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0F" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <!-- display font for the title, subset to just its letters (a few KB) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@800&text=Thousandify&display=swap"
      rel="stylesheet"
    />
    <!-- applies the theme before the first paint to avoid flicker; "theme" is
    the same key next-themes used, so saved preferences carry over -->
    <script is:inline>
      (() => {
        let theme = "system";
        try {
          theme = localStorage.getItem("theme") ?? "system";
        } catch {}
        const dark =
          theme === "dark" ||
          (theme === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="relative isolate bg-background text-table-data min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
